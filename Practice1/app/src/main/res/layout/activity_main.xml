<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00EAFF"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="220dp"
        android:layout_height="51dp"
        android:layout_marginTop="40dp"
        android:background="#FFDE01"
        android:gravity="center"
        android:shadowColor="#070707"
        android:text="Counter App"
        android:textColor="#EF0A0A"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCount"
        android:layout_width="205dp"
        android:layout_height="218dp"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="0"
        android:textColor="#2C2C92"
        android:textSize="150sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title" />

    <Button
        android:id="@+id/btnCount"
        android:layout_width="176dp"
        android:layout_height="166dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="21dp"
        android:text="Count"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/btnReset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtCount" />

    <Button
        android:id="@+id/btnReset"
        android:layout_width="160dp"
        android:layout_height="49dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FD0101"
        android:text="Reset"
        android:textColorLink="#F80606"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCount" />

    <Button
        android:id="@+id/btnUserApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="289dp"
        android:layout_marginTop="124dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#BBFD02"
        android:text="User App"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCount" />
</androidx.constraintlayout.widget.ConstraintLayout>