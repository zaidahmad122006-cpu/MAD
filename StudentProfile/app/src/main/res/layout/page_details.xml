<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="167dp"
        android:layout_height="61dp"
        android:layout_marginStart="122dp"
        android:layout_marginEnd="122dp"
        android:layout_marginBottom="49dp"
        android:gravity="center"
        android:text="Read Data"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/studImage2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtReadDesc"
        android:layout_width="364dp"
        android:layout_height="102dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="119dp"
        android:layout_marginEnd="24dp"
        android:hint="The data is here"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/studImage2" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="125dp"
        android:layout_height="61dp"
        android:layout_marginStart="143dp"
        android:layout_marginTop="148dp"
        android:layout_marginEnd="143dp"
        android:text="Back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtReadDesc" />

    <ImageView
        android:id="@+id/studImage2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="151dp"
        android:layout_marginEnd="152dp"
        android:layout_marginBottom="119dp"
        app:layout_constraintBottom_toTopOf="@+id/txtReadDesc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_launcher_foreground" />
</androidx.constraintlayout.widget.ConstraintLayout>